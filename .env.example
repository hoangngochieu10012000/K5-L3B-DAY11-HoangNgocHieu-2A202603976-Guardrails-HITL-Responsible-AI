# Sao chép file này thành .env rồi điền giá trị thật.
# Không commit file .env lên GitHub.

# =============================================================================
# BLUE TEAM (CP2–CP3) — Liquid AI (https://console.liquid.ai/dashboard/api-keys)
# =============================================================================
OPENROUTER_API_KEY=your_liquid_ai_api_key_here
OPENROUTER_BASE_URL=https://api.liquid.ai/v1
BLUE_MODEL=liquid-preview-lfm-3b

# =============================================================================
# RED TEAM & RED ADVANCE (CP4) — NVIDIA NIM (https://integrate.api.nvidia.com)
# =============================================================================
RED_TEAM_PROVIDER=openai
OPENAI_API_KEY=your_nvidia_api_key_here
OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
OPENAI_MODEL=google/gemma-4-31b-it

# Tắt anonymous usage stats của NeMo Guardrails
NEMO_GUARDRAILS_NO_USAGE_STATS=1
